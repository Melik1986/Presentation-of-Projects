echo "Running pre-commit checks (lint)"

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    if command -v wsl.exe >/dev/null 2>&1; then
      WSL_DISTRO="${WSL_DISTRO:-Ubuntu}"
      WSL_PROJECT_DIR="${WSL_PROJECT_DIR:-/home/pc/projects/Portfolio/Presentation-of-Projects}"
      echo "Forwarding lint to WSL ($WSL_DISTRO:$WSL_PROJECT_DIR)"
      export MSYS_NO_PATHCONV=1
      exec wsl.exe --distribution "$WSL_DISTRO" --cd "$WSL_PROJECT_DIR" --exec bash -lc 'bun run lint'
    fi
    ;;
esac

if command -v bun >/dev/null 2>&1; then
  bun run lint
elif command -v npm >/dev/null 2>&1; then
  npm run lint
else
  echo "Pre-commit lint requires Bun or Node.js/npm on PATH." >&2
  exit 127
fi
